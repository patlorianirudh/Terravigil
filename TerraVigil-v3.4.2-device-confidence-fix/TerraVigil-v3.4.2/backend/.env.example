# Copy this file to .env on the backend host. Keep the key private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RAG_TOP_K=3
RAG_MIN_SCORE=0.30
RAG_GENERATION_TIMEOUT_MS=45000
RAG_INDEX_TIMEOUT_MS=180000

# Local persistent storage is the default. No MongoDB setup is required.
TERRAVIGIL_DB=local
# Optional alternative: TERRAVIGIL_DB=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=terravigil
# Optional absolute folder. Default: backend/data
TERRAVIGIL_DATA_DIR=
PORT=3000

# Setup creates a project .venv, which is discovered automatically.
# Optional absolute path to another configured Python executable:
# Leave blank to use the project virtual environment created by setup.
INFERENCE_PYTHON=
INFERENCE_DEVICE=cpu
INFERENCE_TIMEOUT_MS=120000
INFERENCE_STATUS_TIMEOUT_MS=45000

# Firebase is read by the Python backend only. Paths are relative to the app root.
FIREBASE_ENABLED=true
FIREBASE_DATABASE_URL=https://terravigil-e816d-default-rtdb.asia-southeast1.firebasedatabase.app/
FIREBASE_DETECTIONS_PATH=detections,metal_detections
FIREBASE_SERVICE_ACCOUNT=backend/serviceAccountKey.json
FIREBASE_MISSION_ID=TV-LIVE-001
FIREBASE_POLL_SECONDS=3
# Used ONLY for timestamps with no explicit UTC offset. Verify the camera clock.
FIREBASE_TIMESTAMP_TIMEZONE=Asia/Kolkata
TELEMETRY_TIMESTAMP_TIMEZONE=Asia/Kolkata
# An unmatched timestamp stays pending; do not widen this to match another flight.
TELEMETRY_MAX_GAP_SECONDS=2
# Add this measured correction to detection time for lookup. Never guess an offset.
DETECTION_CLOCK_OFFSET_SECONDS=0
TELEMETRY_CSV_PATH=telemetry/DroneTelemetry/telemetry.csv
DETECTION_IMAGE_DIR=images
TELEMETRY_PYTHON=
MAVLINK_CONNECTION=tcpin:127.0.0.1:5760
MAVLINK_SYSTEM_ID=0

# Optional Firebase Storage bucket for private camera images (exact console bucket name).
FIREBASE_STORAGE_BUCKET=
# Extra HTTPS image hostnames, comma-separated. Firebase/Google Storage hosts are enabled.
DETECTION_IMAGE_HOSTS=
